{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/website/layout,_N_T_/website/terms/layout,_N_T_/website/terms/page,_N_T_/website/terms"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/website/terms/__PAGE__",
    "/website/terms",
    "/website",
    "/_index",
    "/_head"
  ]
}