<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SignalRToBackend" stopProcessing="true">
          <match url="^signalr/(.*)" />
          <action type="Rewrite" url="http://20.240.161.85:778/{R:1}" />
        </rule>
        <rule name="NextJsReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3100/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
